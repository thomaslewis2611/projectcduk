{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectcduk",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Serve on projectcduk.<subdomain>.workers.dev; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false
}

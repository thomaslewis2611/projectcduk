# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The one account allowed to upload/delete reports. Create this user in
# Supabase → Authentication → Users (and turn off public sign-ups there).
